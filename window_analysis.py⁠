from datetime import datetime, timedelta
import os
import numpy as np
import pandas as pd
import torch
import torch.nn as nn

# 1. Caminhos
BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CSV_PATH = os.path.join(BASE_DIR, 'data', 'historico_crash.csv')
MODEL_PATH = os.path.join(BASE_DIR, 'models', 'modelo_crash_lstm.pth')


class CrashLSTM(nn.Module):

  def __init__(self, input_size=1, hidden_size=32, num_layers=1):
    super(CrashLSTM, self).__init__()
    self.lstm = nn.LSTM(input_size, hidden_size, num_layers, batch_first=True)
    self.fc = nn.Linear(hidden_size, 1)

  def forward(self, x):
    out, _ = self.lstm(x)
    return self.fc(out[:, -1, :])


print('=== ANÁLISE DE JANELA & MULTIPLICADORES ALVO ===\n')

# 2. Carregar CSV
df = pd.read_csv(CSV_PATH)
df['timestamp'] = pd.to_datetime(df['timestamp'])

THRESHOLD = 5.0  # Vela alta a partir de 5.0x
velas_altas = df[df['multiplier'] >= THRESHOLD].copy()

if len(velas_altas) >= 2:
  # Intervalo médio entre velas altas
  velas_altas['diff_min'] = (
      velas_altas['timestamp'].diff().dt.total_seconds() / 60.0
  )
  media_intervalo = velas_altas['diff_min'].mean()

  # Estatísticas das velas altas do histórico
  mediana_velas_altas = velas_altas['multiplier'].median()
  media_velas_altas = velas_altas['multiplier'].mean()

  ultima_vela = velas_altas.iloc[-1]
  proxima_janela = ultima_vela['timestamp'] + timedelta(minutes=media_intervalo)
  agora = datetime.now()

  # Projetar para a próxima janela futura
  while proxima_janela < agora:
    proxima_janela += timedelta(minutes=media_intervalo)

  tempo_restante = (proxima_janela - agora).total_seconds()
  minutos_r = int(tempo_restante // 60)
  segundos_r = int(tempo_restante % 60)

  # 3. Previsão da LSTM (se o arquivo existir)
  pred_lstm = None
  if os.path.exists(MODEL_PATH):
    try:
      checkpoint = torch.load(MODEL_PATH)
      min_v, max_v = checkpoint['min_val'], checkpoint['max_val']

      model = CrashLSTM()
      model.load_state_dict(checkpoint['model_state'])
      model.eval()

      ultimas_5 = df['multiplier'].values[-5:]
      norm_5 = (ultimas_5 - min_v) / (max_v - min_v + 1e-8)
      inp = torch.tensor(norm_5, dtype=torch.float32).view(1, 5, 1)

      with torch.no_grad():
        pred_norm = model(inp).item()
      pred_lstm = pred_norm * (max_v - min_v + 1e-8) + min_v
    except Exception:
      pass

  # 4. Definição dos Alvos de Entrada
  alvo_conservador = 2.00
  alvo_moderado = 5.00
  alvo_alavancado = (
      round(pred_lstm * 0.7, 2)
      if (pred_lstm and pred_lstm > 5.0)
      else round(mediana_velas_altas * 0.6, 2)
  )

  # 5. Saída no Terminal
  print(f'Hora Atual do Sistema: {agora.strftime("%H:%M:%S")}')
  print(
      f'Última Vela Alta ({ultima_vela["multiplier"]}x):'
      f' {ultima_vela["timestamp"].strftime("%H:%M:%S")}'
  )
  print(f'Ciclo Médio do Histórico: a cada ~{media_intervalo:.1f} minutos')
  print('-' * 50)
  print(
      '--> HORÁRIO ESTIMADO DA PRÓXIMA JANELA:'
      f' {proxima_janela.strftime("%H:%M:%S")}'
  )
  print(f'--> TEMPO RESTANTE: {minutos_r}m {segundos_r}s')
  print('-' * 50)
  print('SUGESTÕES DE SAÍDA (TARGETS):')
  print(f' 🟢 Conservador (Alta taxa de acerto):  {alvo_conservador:.2f}x')
  print(
      f' 🟡 Moderado (Início da Janela Alta):  {alvo_moderado:.2f}x'
  )
  print(
      ' 🔴 Alavancado (Média do Ciclo):       '
      f' {max(alvo_alavancado, 8.00):.2f}x'
  )
  if pred_lstm:
    print(f' 🤖 Estimativa Pura da LSTM:           {pred_lstm:.2f}x')
  print('-' * 50)

else:
  print('Insira mais dados de velas altas no CSV para projetar a janela.')
